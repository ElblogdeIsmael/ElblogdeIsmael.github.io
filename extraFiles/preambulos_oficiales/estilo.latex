% ========================
% estilo.latex mínimo funcional
% ========================

\documentclass[12pt]{book} % report para capítulos

% ========================
% Paquetes y comandos extra
% ========================
% Paths are relative to extraFiles/, which the subject Makefile puts on
% TEXINPUTS. Do not write ../ here: the template is shared by subjects that
% sit at different depths, and a fixed depth only works for some of them.
\input{preambulos_oficiales/paquetes.tex}  % si tienes paquetes personalizados
\input{preambulos_oficiales/comandos.tex}  % comandos LaTeX propios
\input{preambulos_oficiales/estilos.tex}   % estilos de secciones, etc.

% Pandoc's own syntax highlighting. It emits the Shaded and Highlighting
% environments into this variable, and without the block the document aborts
% with "Environment Shaded undefined" the moment it hits a code block.
%
% That is why every subject passes --listings today: it was the only option.
% But listings reads code verbatim, so it never goes through inputenc and one
% accent inside a code block kills the build, pointing at the wrong line. With
% this block a subject can drop --listings and keep highlighted code.
%
% Guarded, so it stays a no-op for the subjects that still use --listings:
% pandoc only fills the variable when it is doing the highlighting itself.
$if(highlighting-macros)$
$highlighting-macros$
$endif$

% Per-subject preamble additions. A subject that needs a package the shared
% preamble does not load declares it in the YAML of its own src/00_portada.md:
%
%   header-includes: |
%     \usepackage{circuitikz}
%
% Guarded the same way, so it is a no-op for every subject that declares
% nothing. This exists so one subject can pull in a package without adding it
% to the preamble that all the documents of the tree load.
$if(header-includes)$
$for(header-includes)$
$header-includes$
$endfor$
$endif$

% ========================
% Configuración índice y listas
% ========================
\setlength{\cftbeforesecskip}{5pt}
\setlength{\headheight}{14pt}  % un poco más que 13.6pt

\renewcommand{\normalsize}{\fontsize{10}{12}\selectfont}

% Fix para listas de Pandoc
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}



%===============
% ESPACIOS
%===============

% --- Compactar secciones ---
\titlespacing*{\section}{0pt}{1.2ex plus 0.5ex minus 0.2ex}{0.8ex}
\titlespacing*{\subsection}{0pt}{1ex plus 0.3ex minus 0.2ex}{0.5ex}

% --- Compactar flotantes (figuras/tablas) ---
\setlength{\textfloatsep}{8pt}
\setlength{\intextsep}{6pt}
\setlength{\floatsep}{6pt}

% --- Compactar listas ---
\setlist{nosep}

% --- Espacio entre párrafos ---
\setlength{\parskip}{4pt}



%=======================
% fancy with parameters
%=======================
% Never put a template variable inside a comment line here. Pandoc expands it
% and then wraps its output at column 72, so a long value splits in two and
% only the first half stays commented: the rest lands before \begin{document}
% and the build dies with "Missing \begin{document}". It bit the subject named
% "Tecnologia y Organizacion de Computadores", 41 characters.
\fancyfoot[L]{\normalsize $subject$} % pie de página izquierdo con tamaño normal

\setcounter{tocdepth}{1} % Muestra solo hasta subsecciones en el índice

%=======================
% reset chapter 0 with one more \part
%=======================

\makeatletter
\@addtoreset{chapter}{part}
\makeatother


% ========================
% Inicio del documento
% ========================
\begin{document}

% Cambiar puntos suspensivos en el índice
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}

% Ajustar formato de secciones y subsecciones en el índice
\renewcommand{\cftsecfont}{\bfseries} % Secciones en negrita
\renewcommand{\cftsecpagefont}{\bfseries} % Números de página en negrita para secciones
\renewcommand{\cftsubsecfont}{\normalfont} % Subsecciones en formato normal
\renewcommand{\cftsubsecpagefont}{\normalfont} % Números de página en formato normal para subsecciones

% Espaciado entre entradas del índice
\setlength{\cftbeforesecskip}{8pt} % Espaciado antes de secciones
\setlength{\cftbeforesubsecskip}{4pt} % Espaciado antes de subsecciones



%\input{portada}


%==========================
% PORTADA: ENTRADA MANUAL
%==========================

% portada.tex
\begin{titlepage}
    \newgeometry{top=2cm,bottom=2cm,left=2.5cm,right=2.5cm} % márgenes personalizados
    
    % Fondo con transparencia
    \begin{tikzpicture}[remember picture,overlay]
        % \node[opacity=0.15,inner sep=0pt] at (current page.center)
        \node[inner sep=0pt] at (current page.center)
            {\includegraphics[width=\paperwidth,height=\paperheight]{img/fondo_$type$.jpg}};
    \end{tikzpicture}

    % Contenido de la portada
    \begin{center}
        \vspace*{2cm}
        
        \vspace{5cm} % Añadir más espacio antes del contenido
        {\Huge \bfseries\scshape\textcolor{white}{$subject$} \par}
        \vspace{0.5cm}
        {\Large \itshape\textcolor{white}{$about$} \par}
        \vspace{0.5cm}
