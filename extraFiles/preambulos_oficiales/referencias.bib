% Shared bibliography database, in BibTeX format.
%
% paquetes.tex loads biblatex with the biber backend and points \addbibresource
% here, so this file must hold @entries and nothing else. It used to hold a
% LaTeX \begin{thebibliography} block, which biber reads as junk and skips
% without complaining: the bibliography came out empty and nothing said so.
%
% Every subject keeps its own empty referencias.bib next to its document. The
% leading `.` in TEXINPUTS puts that one first, so a subject falls back to this
% file only when it has none of its own.
%
% Add entries as:
%
%   @book{cormen2009,
%     author    = {Cormen, Thomas H. and Leiserson, Charles E.},
%     title     = {Introduction to Algorithms},
%     publisher = {MIT Press},
%     year      = {2009},
%   }
