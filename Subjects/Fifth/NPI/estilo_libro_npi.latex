  before skip=10pt, after skip=10pt,
  fonttitle=\sffamily\bfseries\small\color{npiCobalt},
  attach boxed title to top left={yshift=-2pt},
  boxed title style={empty, size=minimal, top=4pt, bottom=2pt, left=10pt},
  title={\faBookmark\hspace{0.5em}#1}
}

