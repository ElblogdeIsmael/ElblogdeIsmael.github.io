% --- Cabeceras de capítulo y secciones (titlesec + TikZ) ---
\usepackage{titlesec}

\newcommand{\chapband}[2]{%
  \begin{tikzpicture}
    \node[
      fill=npiPaper,
      draw=npiRule,
      line width=0.6pt,
      rounded corners=3pt,
      inner sep=0pt,
      minimum width=\dimexpr\textwidth-1pt\relax
    ] (band) {%
      \begin{minipage}{\dimexpr\textwidth-64pt\relax}
        \vspace{12pt}
        {\sffamily\bfseries\scriptsize\color{npiTeal}\MakeUppercase{#1}}\\[4pt]
        {\Huge\bfseries\color{npiNavy}\raggedright #2\endgraf}
        \vspace{10pt}
      \end{minipage}
      \hspace*{36pt}%
    };
    \fill[npiTeal] (band.north west) rectangle ([xshift=4pt]band.south west);
    \node[
      anchor=north east,
      font=\sffamily\bfseries\fontsize{42}{42}\selectfont,
      text=npiRule!50
    ] at ([xshift=-12pt, yshift=-10pt]band.north east) {\thechapter};
  \end{tikzpicture}%
}

\newcommand{\chapbandunnum}[1]{%
  \begin{tikzpicture}
    \node[
      fill=npiPaper,
      draw=npiRule,
      line width=0.6pt,
      rounded corners=3pt,
      inner sep=0pt,
      minimum width=\dimexpr\textwidth-1pt\relax
    ] (band) {%
      \begin{minipage}{\dimexpr\textwidth-28pt\relax}
        \vspace{10pt}
        {\Huge\bfseries\color{npiNavy}\raggedright #1\endgraf}
        \vspace{8pt}
      \end{minipage}
    };
    \fill[npiNavy] (band.north west) rectangle ([xshift=4pt]band.south west);
  \end{tikzpicture}%
}

\titleformat{\chapter}[display]
  {\normalfont}
  {}
  {0pt}
  {\chapband{Capítulo \thechapter \quad\textperiodcentered\quad Nuevos Paradigmas de Interacción}}

\titleformat{name=\chapter,numberless}[display]
  {\normalfont}
  {}
  {0pt}
  {\chapbandunnum}

\titlespacing*{\chapter}{0pt}{-10pt}{16pt}

\titleformat{\section}
  {\Large\sffamily\bfseries\color{npiNavy}}
  {\textcolor{npiTeal}{\thesection}}{0.8em}{}
  [\vspace{2pt}{\color{npiRule}\titlerule[0.5pt]}]
\titlespacing*{\section}{0pt}{16pt}{6pt}

\titleformat{\subsection}
  {\large\sffamily\bfseries\color{npiNavyMid}}
  {\textcolor{npiCobalt}{\thesubsection}}{0.7em}{}
\titlespacing*{\subsection}{0pt}{11pt}{4pt}

\titleformat{\subsubsection}
  {\normalsize\sffamily\bfseries\itshape\color{npiSlate}}
  {\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}

% --- Encabezados, pies y pestañas de capítulo (fancyhdr + TikZ) ---
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}

\newcommand{\chapterthumb}{%
  \ifnum\value{chapter}>0%
    \begin{tikzpicture}[remember picture, overlay]
      \ifodd\value{page}
        \node[
          fill=npiTeal,
          text=white,
          font=\sffamily\bfseries\footnotesize,
          minimum width=7mm,
          minimum height=11mm,
          anchor=east,
          rounded corners=1.5pt
        ] at ([yshift=-2.8cm-\value{chapter}*1.1cm]current page.north east) {\thechapter};
      \else
        \node[
          fill=npiTeal,
          text=white,
          font=\sffamily\bfseries\footnotesize,
          minimum width=7mm,
          minimum height=11mm,
          anchor=west,
          rounded corners=1.5pt
        ] at ([yshift=-2.8cm-\value{chapter}*1.1cm]current page.north west) {\thechapter};
      \fi
    \end{tikzpicture}%
  \fi%
}

\fancyhead[LE]{%
  \chapterthumb
  \sffamily\footnotesize\bfseries\color{npiNavy}\thepage%
  \hspace{1em}\textcolor{npiRule}{|}\hspace{1em}%
  \normalfont\sffamily\footnotesize\color{npiSlate}\nouppercase{\leftmark}%
}
\fancyhead[RO]{%
  \chapterthumb
  \sffamily\footnotesize\color{npiSlate}\nouppercase{\rightmark}%
  \hspace{1em}\textcolor{npiRule}{|}\hspace{1em}%
  \bfseries\color{npiNavy}\thepage%
}
\fancyfoot[LE]{\sffamily\scriptsize\color{npiMuted} $subject$ \textperiodcentered\ UGR}
\fancyfoot[RO]{\sffamily\scriptsize\color{npiMuted} $author$}

