% Epígrafe de capítulo
\newcommand{\epigrafe}[2]{%
  \begin{flushright}
  \begin{minipage}{0.78\textwidth}
  \raggedleft\itshape\color{ceslate}\small
  ``#1''\\[3pt]
  \normalfont\sffamily\footnotesize\bfseries\color{ceindigo} --- #2
  \end{minipage}
  \end{flushright}
  \vspace{6pt}
}

% Portadilla de Parte con ilustración editorial
\newcommand{\parteLibro}[4]{%
  \cleardoublepage
  \thispagestyle{empty}
  \refstepcounter{part}
  \addcontentsline{toc}{part}{Parte \thepart. #2}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[cecream] (current page.south west) rectangle (current page.north east);
    \fill[ceindigo] (current page.north west) rectangle ($$(current page.south west)+(1.1cm,0)$$);
    \fill[cecrimson] ($$(current page.north west)+(1.1cm,0)$$) rectangle ($$(current page.south west)+(1.28cm,0)$$);
  \end{tikzpicture}
  \vspace*{0.4cm}
  \hspace*{0.8cm}\begin{minipage}{0.88\textwidth}
    {\sffamily\bfseries\small\color{cecrimson}\MakeUppercase{PARTE \thepart}\par}
    \vspace{0.3cm}
    {\sffamily\bfseries\fontsize{26}{30}\selectfont\color{ceindigo}#2\par}
    \vspace{0.25cm}
    {\Large\itshape\color{ceslate}#3\par}
    \vspace{0.5cm}
    {\color{ceteal}\rule{4.5cm}{2pt}}
    \vspace{0.55cm}
    \begin{center}
      \fcolorbox{cemuted!60}{white}{\includegraphics[width=0.90\linewidth,height=9.0cm,keepaspectratio]{#1}}
    \end{center}
    \vspace{0.5cm}
    \begin{tcolorbox}[
      enhanced, colback=white, colframe=cemuted!60,
      borderline west={3pt}{0pt}{ceamber}, boxrule=0.4pt, arc=2pt,
      left=10pt, right=10pt, top=8pt, bottom=8pt
    ]
      {\sffamily\bfseries\footnotesize\color{ceindigo} CONTENIDOS DE ESTA PARTE\par}
      \vspace{4pt}
      {\small\color{cedeep!90}#4}
    \end{tcolorbox}
  \end{minipage}
  \newpage
}

% --- Títulos de Capítulos y Secciones (titlesec) ---
\usepackage{titlesec}

\titleformat{\chapter}[display]
  {\normalfont\sffamily}
  {\begin{tikzpicture}[baseline=(num.base)]
    \node[fill=ceindigo, text=white, font=\sffamily\bfseries\footnotesize, inner xsep=8pt, inner ysep=4pt, rounded corners=1.5pt] (lbl) {\MakeUppercase{\chaptertitlename}};
    \node[right=6pt of lbl, font=\sffamily\bfseries\fontsize{36}{38}\selectfont, text=cecrimson] (num) {\thechapter};
  \end{tikzpicture}}
  {6pt}
  {\sffamily\bfseries\fontsize{22}{26}\selectfont\color{ceindigo}\raggedright}
  [\vspace{6pt}{\makebox[0pt][l]{\color{ceteal}\rule[-0.4pt]{3.2cm}{2.4pt}}{\color{ceindigo}\rule{\linewidth}{1.2pt}}}]

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\sffamily}
  {}
  {0pt}
  {\sffamily\bfseries\fontsize{22}{26}\selectfont\color{ceindigo}\raggedright}
  [\vspace{6pt}{\color{ceindigo}\rule{\linewidth}{1.2pt}}]

\titlespacing*{\chapter}{0pt}{4pt}{16pt}

\titleformat{\section}
  {\sffamily\Large\bfseries\color{ceindigo}}
  {\colorbox{cepanel}{\color{cecrimson}\thesection}}{0.7em}{}
\titlespacing*{\section}{0pt}{16pt}{6pt}

\titleformat{\subsection}
  {\sffamily\large\bfseries\color{ceteal!85!black}}
  {\thesubsection}{0.7em}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

\titleformat{\subsubsection}
  {\sffamily\normalsize\bfseries\color{ceslate}}
  {\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}

% --- Encabezados y Pies de Página (fancyhdr) ---
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\footnotesize\color{ceslate}\nouppercase{\leftmark}}
\fancyhead[R]{%
  \begin{tikzpicture}[baseline=(p.base)]
    \node[fill=ceindigo, text=white, font=\sffamily\bfseries\footnotesize, inner xsep=6pt, inner ysep=3pt, rounded corners=1.5pt] (p) {\thepage};
  \end{tikzpicture}%
}
\fancyfoot[L]{\sffamily\scriptsize\color{ceslate} $subject$}
\fancyfoot[R]{\sffamily\scriptsize\color{ceslate} $author$}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.3pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{cemuted}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{cemuted}\leaders\hrule height \footrulewidth\hfill}}

\fancypagestyle{plain}{
  \fancyhf{}
  \fancyfoot[C]{%
    \begin{tikzpicture}[baseline=(p.base)]
      \node[fill=cepanel, draw=cemuted, text=ceindigo, font=\sffamily\bfseries\footnotesize, inner xsep=6pt, inner ysep=2.5pt, rounded corners=1.5pt] (p) {\thepage};
    \end{tikzpicture}%
  }
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

% --- Tabla de Contenidos estilizada (tocloft) ---
\usepackage{tocloft}
\renewcommand{\cftchapfont}{\sffamily\bfseries\color{ceindigo}}
\renewcommand{\cftchappagefont}{\sffamily\bfseries\color{cecrimson}}
\renewcommand{\cftsecfont}{\sffamily\small\color{cedeep}}
\renewcommand{\cftsecpagefont}{\sffamily\small\color{ceslate}}
\renewcommand{\cftsubsecfont}{\sffamily\footnotesize\color{ceslate}}
\renewcommand{\cftsubsecpagefont}{\sffamily\footnotesize\color{ceslate}}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}
\setlength{\cftbeforechapskip}{8pt}
\setlength{\cftbeforesecskip}{2.5pt}
\setcounter{tocdepth}{1}

% --- Numeración ---
\numberwithin{equation}{chapter}
\numberwithin{figure}{chapter}
\numberwithin{table}{chapter}

% --- Hipervínculos ---
\usepackage[plainpages=false,pdfpagelabels]{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=ceindigo,
  citecolor=ceteal,
  urlcolor=cecrimson,
  pdftitle={$subject$},
  pdfauthor={$author$},
  pdfsubject={Creación de Empresas · UGR},
  pdfcreator={XeLaTeX}
}

