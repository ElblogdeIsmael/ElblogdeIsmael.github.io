  colbacktitle=cepanel,
  attach boxed title to top left={yshift=-2mm, xshift=10pt},
  boxed title style={colback=cepanel, boxrule=0pt, frame hidden, left=3pt, right=3pt},
  title={MARCO TEÓRICO · #1}
}

