\documentclass[10pt,a4paper,oneside]{book}

% --- Motores tipográficos (XeLaTeX) ---
\usepackage{fontspec}
\usepackage{polyglossia}
\setmainlanguage{spanish}
\usepackage{csquotes}

% --- Tipografía Editorial: TeX Gyre Pagella (cuerpo) + Lato (títulos/cajas) + DejaVu Sans Mono ---
\setmainfont{TeX Gyre Pagella}[
  Ligatures=TeX,
  Numbers=Proportional
]
\setsansfont{Lato}[
  Scale=MatchLowercase,
  Ligatures=TeX
]
\setmonofont{DejaVu Sans Mono}[
  Scale=0.84
]

% --- Matemáticas limpias ---
\usepackage{amsmath,amssymb,amsthm,mathtools}
\usepackage{unicode-math}
\setmathfont{TeX Gyre Pagella Math}

% --- Geometría editorial equilibrada ---
\usepackage{geometry}
\geometry{
  a4paper,
  top=2.35cm,
  bottom=2.35cm,
  left=2.35cm,
  right=2.15cm,
  headheight=22pt,
  headsep=16pt,
  footskip=26pt
}

\usepackage{microtype}
\usepackage{setspace}
\setstretch{1.16}
\setlength{\parskip}{5pt}
\setlength{\parindent}{0pt}
\raggedbottom

% --- Paleta cromática editorial ---
\usepackage{xcolor}
\definecolor{ceindigo}{RGB}{18, 49, 82}      % Azul pizarra dominante
\definecolor{cedeep}{RGB}{12, 34, 58}        % Azul noche profundo
\definecolor{cecrimson}{RGB}{178, 34, 52}    % Carmesí institucional / alertas
\definecolor{ceteal}{RGB}{15, 118, 110}      % Verde esmeralda operaciones/casos
\definecolor{ceamber}{RGB}{194, 110, 14}     % Ámbar dorado clase/foco
\definecolor{ceviolet}{RGB}{91, 66, 138}     % Púrpura pizarra TI+ADE
\definecolor{ceslate}{RGB}{71, 85, 105}      % Gris pizarra texto secundario
\definecolor{cemuted}{RGB}{148, 163, 184}    % Gris claro reglas
\definecolor{cecream}{RGB}{250, 249, 246}    % Papel tintado cálido
\definecolor{cepanel}{RGB}{243, 246, 250}    % Fondo azulado suave
\definecolor{cepanelteal}{RGB}{240, 250, 248}
\definecolor{cepanelamber}{RGB}{254, 249, 240}
\definecolor{cepanelcrimson}{RGB}{253, 243, 244}
\definecolor{cepanelviolet}{RGB}{246, 244, 252}

% --- Gráficos, TikZ, pgfplots y tablas ---
\usepackage{graphicx}
\graphicspath{{media/}{src/tex/}}
\usepackage{float}
\usepackage{tikz}
\usetikzlibrary{
  calc, positioning, shapes, shapes.geometric, shapes.misc,
  arrows.meta, shadows.blur, backgrounds, fit, decorations.pathreplacing,
  decorations.markings, patterns
}
\usepackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween}

\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\usepackage{tabularx}
\usepackage{multirow}
\usepackage{colortbl}
\usepackage{etoolbox}
\usepackage{eurosym}

% Estilo uniforme para tablas Markdown (longtable) y LaTeX (tabular/tabularx)
\AtBeginEnvironment{longtable}{%
  \sffamily\small
  \rowcolors{2}{cepanel!55}{white}%
  \renewcommand{\arraystretch}{1.28}%
}
\AtBeginEnvironment{tabularx}{%
  \sffamily\small
  \rowcolors{2}{cepanel!55}{white}%
  \renewcommand{\arraystretch}{1.25}%
}
\AtBeginEnvironment{tabular}{%
  \sffamily\small
  \renewcommand{\arraystretch}{1.25}%
}

% --- Pies de figura y tabla ---
\usepackage{caption}
\usepackage{subcaption}
\captionsetup{
  font={small,sf},
  labelfont={bf,color=ceindigo},
  textfont={color=ceslate},
  labelsep=period,
  justification=centering,
  skip=8pt
}

% --- Listas limpias ---
\usepackage{enumitem}
\setlist{topsep=3pt, itemsep=2.5pt, parsep=1pt}
\setlist[itemize,1]{label=\textcolor{ceteal}{\textbullet}, leftmargin=1.4em}
\setlist[itemize,2]{label=\textcolor{ceamber}{\textendash}, leftmargin=1.2em}
\setlist[enumerate,1]{label=\textcolor{ceindigo}{\sffamily\bfseries\arabic*.}, leftmargin=1.6em}

\providecommand{\tightlist}{%
  \setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}%
}

