% --- PÁGINA DE CRÉDITOS Y MAPA EDITORIAL ---
\newpage
\thispagestyle{empty}
\vspace*{\fill}
\begin{tcolorbox}[
  enhanced, colback=cecream, colframe=cemuted!60,
  borderline west={3pt}{0pt}{ceindigo}, boxrule=0.4pt, arc=2pt,
  left=12pt, right=12pt, top=10pt, bottom=10pt
]
  {\sffamily\bfseries\small\color{ceindigo} CREACIÓN DE EMPRESAS · MANUAL INTEGRAL DE LA ASIGNATURA\par}
  \vspace{6pt}
  {\small\color{cedeep}
  Documento de estudio elaborado para el 5.º curso del Doble Grado en Ingeniería Informática y Administración y Dirección de Empresas de la Universidad de Granada (Guía Docente 2161153).\\[6pt]
  \textbf{Eje doctrinal y bibliográfico:} integra los contenidos de los Temas 1 a 10 de la guía docente oficial junto con las obras de referencia internacional: Osterwalder y Pigneur (\textit{Business Model Generation}), Osterwalder et al. (\textit{Value Proposition Design}), Eric Ries (\textit{The Lean Startup}), Steve Blank y Bob Dorf (\textit{The Startup Owner's Manual}), Saras Sarasvathy (\textit{Effectuation}), Ash Maurya (\textit{Running Lean}), Bill Aulet (\textit{Disciplined Entrepreneurship}), Geoffrey Moore (\textit{Crossing the Chasm}), Peter Thiel (\textit{Zero to One}), Kim y Mauborgne (\textit{La estrategia del océano azul}), Hisrich, Peters y Shepherd (\textit{Entrepreneurship}), Gómez Gras et al., Barringer e Ireland, Weill y Vitale, y la normativa mercantil, fiscal y laboral española vigente (Ley 18/2022 Crea y Crece, Ley 28/2022 de Startups y cotizaciones 2026).}
\end{tcolorbox}
\vspace{0.5cm}

