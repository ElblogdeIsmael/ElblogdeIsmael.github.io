% --- Titulos de capitulo y seccion arquitectonicos ---
\usepackage{titlesec}
\usepackage{titletoc}

\titleformat{\chapter}[display]
  {\normalfont\sffamily}
  {%
    \makebox[0pt][l]{\colorbox{dfinnavy}{\textcolor{white}{\bfseries\scriptsize\hspace{8pt}CAPÍTULO\hspace{8pt}}}}%
    \hspace{5.8em}{\color{dfincopper}\fontsize{28}{30}\selectfont\bfseries\thechapter}%
  }
  {8pt}
  {\fontsize{21}{25}\selectfont\bfseries\color{dfinnavy}}
  [\vspace{6pt}{\color{dfinemerald}\rule{2.8cm}{2.2pt}}{\color{dfinnavy!30}\rule{\dimexpr\textwidth-2.8cm\relax}{0.6pt}}]

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\sffamily}
  {}
  {0pt}
  {\fontsize{21}{25}\selectfont\bfseries\color{dfinnavy}}
  [\vspace{6pt}{\color{dfincopper}\rule{\textwidth}{0.9pt}}]

\titlespacing*{\chapter}{0pt}{-14pt}{16pt}

\titleformat{\section}
  {\normalfont\sffamily\Large\bfseries\color{dfinnavy}}
  {\colorbox{dfinpanelcopper}{\textcolor{dfincopper}{\thesection}}}
  {0.65em}
  {}
\titlespacing*{\section}{0pt}{16pt}{6pt}

\titleformat{\subsection}
  {\normalfont\sffamily\large\bfseries\color{dfinemerald!90!black}}
  {\thesubsection}
  {0.55em}
  {}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}

\titleformat{\subsubsection}
  {\normalfont\sffamily\normalsize\bfseries\color{dfinslate}}
  {\thesubsubsection}
  {0.5em}
  {}

% --- Pagina separadora de Parte editorial con ilustracion arquitectonica ---
\newcommand{\parteLibro}[4]{%
  \clearpage
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture, overlay]
    \fill[dfinivory] (current page.south west) rectangle (current page.north east);
    \fill[dfinnavy] (current page.north west) rectangle ($$(current page.north east)+(0,-1.0cm)$$);
    \fill[dfincopper] ($$(current page.north west)+(0,-1.0cm)$$) rectangle ($$(current page.north east)+(0,-1.18cm)$$);
    \fill[dfinnavy] (current page.south west) rectangle ($$(current page.south east)+(0,0.55cm)$$);
  \end{tikzpicture}
  \vspace*{0.4cm}
  \begin{center}
    {\sffamily\bfseries\small\color{dfincopper}\MakeUppercase{PARTE #1}}\\[8pt]
    {\sffamily\bfseries\fontsize{25}{30}\selectfont\color{dfinnavy}#2}\\[8pt]
    {\color{dfinemerald}\rule{4.5cm}{1.8pt}}\\[10pt]
    \begin{minipage}{0.82\textwidth}
      \centering\itshape\color{dfinslate}#3
    \end{minipage}\\[16pt]
    \fcolorbox{dfinnavy!25}{white}{\includegraphics[width=0.58\textwidth,height=0.58\textwidth,keepaspectratio]{#4}}
  \end{center}
  \addcontentsline{toc}{part}{Parte #1: #2}
  \clearpage
}

% --- Cajas Pedagogicas con tcolorbox ---
\usepackage[most]{tcolorbox}

% 1. Axioma / Fundamento teorico y demostracion
\newtcolorbox{axioma}[2][]{
  enhanced, breakable,
  colback=dfinpanelivory,
  colframe=dfinnavy,
  boxrule=0pt, borderline west={3.2pt}{0pt}{dfinnavy},
  arc=2pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  fonttitle=\sffamily\bfseries\footnotesize\color{white},
  colbacktitle=dfinnavy,
  attach boxed title to top left={yshift=-2mm, xshift=4mm},
  boxed title style={arc=2pt, boxrule=0pt, top=2.5pt, bottom=2.5pt, left=7pt, right=7pt},
  title={AXIOMA Y FUNDAMENTO \textperiodcentered{} #2},
  #1
}

% 2. Enfoque / Convencion de Aula UGR
\newtcolorbox{claseugr}[2][]{
  enhanced, breakable,
  colback=dfinpanelcopper,
  colframe=dfincopper,
  boxrule=0.6pt,
  arc=3pt,
  left=10pt, right=10pt, top=9pt, bottom=8pt,
  fonttitle=\sffamily\bfseries\footnotesize\color{dfincopper!90!black},
  colbacktitle=dfinivory,
  attach boxed title to top left={yshift=-2.3mm, xshift=4mm},
  boxed title style={arc=2pt, boxrule=0.5pt, colframe=dfincopper, top=1.5pt, bottom=1.5pt, left=6pt, right=6pt},
  title={CONVENCIÓN UGR \textperiodcentered{} #2},
  #1
}

% 3. Caso Corporativo / Examen Resuelto
\newtcolorbox{casoreal}[2][]{
  enhanced, breakable,
  colback=dfinpanelemerald,
  colframe=dfinemerald,
  boxrule=0pt, borderline west={3.2pt}{0pt}{dfinemerald},
  arc=2pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  fonttitle=\sffamily\bfseries\footnotesize\color{dfinemerald!95!black},
  colbacktitle=white,
  attach boxed title to top left={yshift=-2.2mm, xshift=4mm},
  boxed title style={arc=2pt, boxrule=0.5pt, colframe=dfinemerald, top=1.5pt, bottom=1.5pt, left=6pt, right=6pt},
  title={CASO APLICADO \textperiodcentered{} #2},
  #1
}

% 4. Paradoja y Error Frecuente de Examen
\newtcolorbox{trampa}[2][]{
  enhanced, breakable,
  colback=dfinpanelburg,
  colframe=dfinburg,
  boxrule=0.6pt,
  arc=3pt,
  left=10pt, right=10pt, top=9pt, bottom=8pt,
  fonttitle=\sffamily\bfseries\footnotesize\color{dfinburg},
  colbacktitle=white,
  attach boxed title to top left={yshift=-2.3mm, xshift=4mm},
  boxed title style={arc=2pt, boxrule=0.5pt, colframe=dfinburg, top=1.5pt, bottom=1.5pt, left=6pt, right=6pt},
  title={PARADOJA Y ERROR DE EXAMEN \textperiodcentered{} #2},
  #1
}

% 5. Modelado Cuantitativo y Computacional (Puente Informatica + ADE)
\newtcolorbox{puenteti}[2][]{
  enhanced, breakable,
  colback=dfinpanelnavy,
  colframe=dfinnavy!80!dfinemerald,
  boxrule=0pt, borderline west={3.2pt}{0pt}{dfinnavy!80!dfinemerald},
  arc=2pt,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  fonttitle=\sffamily\bfseries\footnotesize\color{dfinnavy!85!black},
  colbacktitle=white,
  attach boxed title to top left={yshift=-2.2mm, xshift=4mm},
  boxed title style={arc=2pt, boxrule=0.5pt, colframe=dfinnavy!70, top=1.5pt, bottom=1.5pt, left=6pt, right=6pt},
  title={ALGORITMIA Y MODELADO FINANCIERO \textperiodcentered{} #2},
  #1
}

% 6. Identidad / Formula Maestra
\newtcolorbox{formula}[2][]{
  enhanced, breakable,
  colback=dfinivory,
  colframe=dfinnavy,
  boxrule=0.7pt,
  arc=3pt,
  left=10pt, right=10pt, top=7pt, bottom=7pt,
  fonttitle=\sffamily\bfseries\footnotesize\color{white},
  colbacktitle=dfinnavy,
  title={IDENTIDAD MAESTRA \textperiodcentered{} #2},
  #1
}

% 7. Epigrafe de inicio de capitulo y Mapa Conceptual
\newenvironment{epigrafe}[2]{%
  \begin{flushright}
  \begin{minipage}{0.76\textwidth}
  \raggedleft\itshape\color{dfinslate}
  ``#1''\\[3pt]
  \normalfont\sffamily\scriptsize\bfseries\color{dfinnavy} --- #2
  \end{minipage}
  \end{flushright}
  \vspace{6pt}
}{}

\newtcolorbox{objetivos}{
  enhanced, breakable,
  colback=dfinpanelivory,
  colframe=dfinmuted!45,
  boxrule=0.5pt,
  borderline west={3pt}{0pt}{dfincopper},
  arc=2pt,
  left=10pt, right=10pt, top=7pt, bottom=7pt,
  fontupper=\small
}

